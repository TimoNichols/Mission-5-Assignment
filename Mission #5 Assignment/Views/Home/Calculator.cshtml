@{
    ViewData["Title"] = "Coaching Calculator";
}

<div class="text-center">
    <h1 class="display-4">Fortnite Coaching Calculator</h1>
    <p class="lead">Calculate how much coaching sessions will cost</p>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <div class="mb-3">
                    <label for="hours" class="form-label">Number of Hours Needed:</label>
                    <input type="number" class="form-control" id="hours" placeholder="Enter number of hours" min="0" step="0.5" />
                    <div id="hoursError" class="text-danger mt-1" style="display: none;">Please enter a positive number.</div>
                </div>

                <div class="mb-3">
                    <label for="hourlyRate" class="form-label">Hourly Rate:</label>
                    <input type="text" class="form-control" id="hourlyRate" value="$25.00" readonly />
                </div>

                <div class="mb-3">
                    <button type="button" id="calculateBtn" class="btn btn-primary w-100">Calculate Total</button>
                </div>

                <div class="mb-3">
                    <label for="totalCost" class="form-label">Total Cost:</label>
                    <input type="text" class="form-control" id="totalCost" readonly placeholder="$0.00" />
                </div>
            </div>
        </div>

        <div class="mt-4 text-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/calculator.js" asp-append-version="true"></script>
}
